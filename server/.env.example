DATABASE_URL=postgres://postgres:postgres@localhost:5432/aiguard
LISTEN_ADDR=127.0.0.1:18765
AIGUARD_PUBLIC_BASE_URL=https://license.example.com
LICENSE_KEY_ID=default
# Generate a random 32-byte seed; never commit real secrets.
LICENSE_SIGNING_SEED_BASE64=
# Optional production security services
REDIS_URL=redis://127.0.0.1:6379/
# Base32 TOTP secret. When set, X-MFA-Code is mandatory for admin APIs.
ADMIN_MFA_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_TOKEN=change-me

