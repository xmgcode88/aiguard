{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIGuard",
  "version": "0.1.0",
  "identifier": "com.aiguard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIGuard",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": "all",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
